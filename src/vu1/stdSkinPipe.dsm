.equ vertexTop, 0x2d0	;; need space for matrices
.equ numUnpackAttribs, 5
.equ numInAttribs, 4
.equ numOutAttribs, 3
.equ numOutBuf, 2
.equ vertCount, ((vertexTop-numOutBuf)/(numUnpackAttribs*2+numOutAttribs*numOutBuf))
.equ offset, (vertCount*numUnpackAttribs)
.equ outBuf1, (2*offset) 
;.equ outSize, ((vertexTop-outBuf1-numOutBuf)/numOutBuf)
.equ outSize, (1 + vertCount*numOutAttribs)
.equ outBuf2, (outBuf1+outSize) 

.equ clipVertCount, ((vertexTop-outBuf1-numOutBuf)/(numUnpackAttribs+numOutAttribs*numOutBuf))
.equ clipOutSize, (1 + clipVertCount*numOutAttribs)
.equ clipOutBuf2, (outBuf1+clipOutSize)
.equ clipBuf, (clipOutBuf2+clipOutSize)	

; up to 9 verts => 7 tris per poly in worst case, a lot for lists unfortunately
.equ clipVertLimitTL, (clipVertCount-21)
.equ clipVertLimitTS, (clipVertCount-15)	;;; TODO: this crashes when i set it to -9 as it should be

.include "defines.inc"


;; 64*4 qwords
.equ boneMatrices,	0x2d0

;; lights
.equ colorClamp,	0x3d0
.equ vertFactor,	0x3d1
.equ lightDirs,		0x3d2
.equ lightBase,		0x3d5
.equ lightCols,		0x3d6
.equ lightDirs2,	0x3da
.equ lightXXX,		0x3dd
.equ lightCols2,	0x3de


#define UN_VERTEX(n,r) 0 + (n)*numUnpackAttribs(r)
#define UN_UV(n,r) 1 + (n)*numUnpackAttribs(r)
#define UN_RGBA(n,r) 2 + (n)*numUnpackAttribs(r)
#define UN_NORMAL(n,r) 3 + (n)*numUnpackAttribs(r)
#define UN_SKIN(n,r) 4 + (n)*numUnpackAttribs(r)

#define IN_VERTEX(n,r) 0 + (n)*numInAttribs(r)
#define IN_UV(n,r) 1 + (n)*numInAttribs(r)
#define IN_RGBA(n,r) 2 + (n)*numInAttribs(r)
#define IN_NORMAL(n,r) 3 + (n)*numInAttribs(r)

#define OUT_STQ(n,r) 0 + (n)*numOutAttribs(r)
#define OUT_RGBA(n,r) 1 + (n)*numOutAttribs(r)
#define OUT_XYZ(n,r) 2 + (n)*numOutAttribs(r)

.balign 16,0

code:

DMAret *
MPG 0, *
.vu
start:
	nop				ilw.y vi12,codeSwitch(vi00)
	nop				ilw.z vi13,codeSwitch(vi00)
	nop				lq vf28,matrix0(vi00)
	nop				lq vf29,matrix1(vi00)
	nop				lq vf30,matrix2(vi00)
	nop				lq vf31,matrix3(vi00)
	nop				lq vf27,xyzwScale(vi00)
	nop				lq vf26,xyzwOffset(vi00)
	nop				lq vf25,colorScale(vi00)
	nop				lq vf24,clipConsts(vi00)
restart:
	nop				ilw.x vi09,codeSwitch(vi00)	; process switch

	;; Calculate end of input buffer with vertex count rounded up to multiple of 4
	;; Note that the maximum vertex count is always a multiple of 4 so this is always legal
	nop				xtop vi02			; input pointer
	nop				xitop vi01			; vertex count
	nop				iaddiu vi03,vi01,3
	nop				iaddiu vi04,vi00,~3
	nop				iand vi04,vi03,vi04		; round up vertex count
	nop				iadd vi03,vi02,vi04
.rept numInAttribs-1
	nop				iadd vi03,vi03,vi04
.endr

.if 1
	nop				loi 0.007874015748031496
	nop				xtop vi04			; unpack pointer
	nop				lq vf05,UN_NORMAL(0,vi04)
	nop				lq vf03,UN_RGBA(0,vi04)
	nop				lq vf01,UN_VERTEX(0,vi04)
	nop				ilw.x vi05,UN_SKIN(0,vi04)
	itof0 vf05,vf05			lq vf02,UN_UV(0,vi04)		; normal to float
	itof0 vf03,vf03			lq vf10,boneMatrices+0(vi05)
	nop				lq vf11,boneMatrices+1(vi05)
	nop				lq vf12,boneMatrices+2(vi05)
	muli vf05,vf05,i		lq vf13,boneMatrices+3(vi05)
SkinLoop:	; 41 cycles per vert
	mulax acc,vf10,vf01		ilw.y vi05,UN_SKIN(0,vi04)
	madday acc,vf11,vf01		sq vf02,IN_UV(0,vi02)
	maddaz acc,vf12,vf01		sq vf03,IN_RGBA(0,vi02)
	maddw vf02,vf13,vf00		lq vf15,boneMatrices+0(vi05)
	mulax acc,vf10,vf05		lq vf16,boneMatrices+1(vi05)
	madday acc,vf11,vf05		lq vf17,boneMatrices+2(vi05)
	maddz vf06,vf12,vf05		lq vf18,boneMatrices+3(vi05)

	mulax acc,vf15,vf01		ilw.z vi05,UN_SKIN(0,vi04)
	madday acc,vf16,vf01		nop
	maddaz acc,vf17,vf01		nop
	maddw vf03,vf18,vf00		lq vf10,boneMatrices+0(vi05)
	mulax acc,vf15,vf05		lq vf11,boneMatrices+1(vi05)
	madday acc,vf16,vf05		lq vf12,boneMatrices+2(vi05)
	maddz vf07,vf17,vf05		lq vf13,boneMatrices+3(vi05)

	mulax acc,vf10,vf01		ilw.w vi05,UN_SKIN(0,vi04)
	madday acc,vf11,vf01		nop
	maddaz acc,vf12,vf01		nop
	maddw vf04,vf13,vf00		lq vf15,boneMatrices+0(vi05)
	mulax acc,vf10,vf05		lq vf16,boneMatrices+1(vi05)
	madday acc,vf11,vf05		lq vf17,boneMatrices+2(vi05)
	maddz vf08,vf12,vf05		lq vf18,boneMatrices+3(vi05)

	mulax acc,vf15,vf01		  ilw.x vi05,UN_SKIN(1,vi04)
	madday acc,vf16,vf01		nop
	maddaz acc,vf17,vf01		iaddiu vi02,vi02,numInAttribs
	maddw vf19,vf18,vf00		lq vf14,UN_SKIN(0,vi04)
	mulax acc,vf15,vf05		nop
	madday acc,vf17,vf05		move.w vf19,vf01
	maddz vf09,vf18,vf05		nop

	;; skinned vertex
	mulax acc,vf02,vf14		  lq vf01,UN_VERTEX(1,vi04)
	madday acc,vf03,vf14		  lq vf05,UN_NORMAL(1,vi04)
	maddaz acc,vf04,vf14		  lq vf03,UN_RGBA(1,vi04)
	maddw.xyz vf19,vf19,vf14  	  lq vf02,UN_UV(1,vi04)
	;; skinned normal
	mulax acc,vf06,vf14		  lq vf10,boneMatrices+0(vi05)
	madday acc,vf07,vf14		  lq vf11,boneMatrices+1(vi05)
	maddaz acc,vf08,vf14		  lq vf12,boneMatrices+2(vi05)
	maddw vf09,vf09,vf14	  	  lq vf13,boneMatrices+3(vi05)

	  itof0 vf05,vf05		iaddiu vi04,vi04,numUnpackAttribs
	  itof0 vf03,vf03		sq vf19,IN_VERTEX(-1,vi02)
	nop				nop				; gah, the extra cycle for muli >:U
	nop				ibne vi02,vi03,SkinLoop
	  muli vf05,vf05,i		sq vf09,IN_NORMAL(-1,vi02)

.else
	nop				loi 0.007874015748031496
	nop				xtop vi04			; unpack pointer
SkinLoop:
	nop				lq vf01,UN_VERTEX(0,vi04)
	nop				lq vf02,UN_UV(0,vi04)
	nop				lq vf03,UN_RGBA(0,vi04)
	nop				lq vf05,UN_NORMAL(0,vi04)
	nop				lq vf14,UN_SKIN(0,vi04)		; can be later..
	nop				ilw.x vi05,UN_SKIN(0,vi04)	; also later
	nop				ilw.y vi06,UN_SKIN(0,vi04)
	nop				ilw.z vi07,UN_SKIN(0,vi04)
	nop				ilw.w vi08,UN_SKIN(0,vi04)
	itof0 vf05,vf05			nop				; normal to float
	itof0 vf03,vf03			nop				; RGBA to float
	nop				nop			
	nop				sq vf02,IN_UV(0,vi02)
	muli vf05,vf05,i		nop				; scale normal
	nop				sq vf03,IN_RGBA(0,vi02)

.if 1	;; enable/disable skinning
	;; four M[i]*V and M[i]*N transformations
	;; matrices better be orthogonal
	nop				lq vf10,boneMatrices+0(vi05)
	nop				lq vf11,boneMatrices+1(vi05)
	nop				lq vf12,boneMatrices+2(vi05)
	nop				lq vf13,boneMatrices+3(vi05)
	mulax acc,vf10,vf01		nop
	madday acc,vf11,vf01		nop
	maddaz acc,vf12,vf01		nop
	maddw vf02,vf13,vf00		nop
	mulax acc,vf10,vf05		nop
	madday acc,vf11,vf05		nop
	maddz vf06,vf12,vf05		nop

	nop				lq vf10,boneMatrices+0(vi06)
	nop				lq vf11,boneMatrices+1(vi06)
	nop				lq vf12,boneMatrices+2(vi06)
	nop				lq vf13,boneMatrices+3(vi06)
	mulax acc,vf10,vf01		nop
	madday acc,vf11,vf01		nop
	maddaz acc,vf12,vf01		nop
	maddw vf03,vf13,vf00		nop
	mulax acc,vf10,vf05		nop
	madday acc,vf11,vf05		nop
	maddz vf07,vf12,vf05		nop

	nop				lq vf10,boneMatrices+0(vi07)
	nop				lq vf11,boneMatrices+1(vi07)
	nop				lq vf12,boneMatrices+2(vi07)
	nop				lq vf13,boneMatrices+3(vi07)
	mulax acc,vf10,vf01		nop
	madday acc,vf11,vf01		nop
	maddaz acc,vf12,vf01		nop
	maddw vf04,vf13,vf00		nop
	mulax acc,vf10,vf05		nop
	madday acc,vf11,vf05		nop
	maddz vf08,vf12,vf05		nop

	nop				lq vf10,boneMatrices+0(vi08)
	nop				lq vf11,boneMatrices+1(vi08)
	nop				lq vf12,boneMatrices+2(vi08)
	nop				lq vf13,boneMatrices+3(vi08)
	mulax acc,vf10,vf01		nop
	madday acc,vf11,vf01		nop
	maddaz acc,vf12,vf01		nop
	maddw.xyz vf01,vf13,vf00	nop
	mulax acc,vf10,vf05		nop
	madday acc,vf11,vf05		nop
	maddz.xyz vf05,vf12,vf05	nop

	;; skinned vertex
	mulax acc,vf02,vf14		nop
	madday acc,vf03,vf14		nop
	maddaz acc,vf04,vf14		nop
	maddw.xyz vf01,vf01,vf14	nop
	;; skinned normal
	mulax acc,vf06,vf14		nop
	madday acc,vf07,vf14		nop
	maddaz acc,vf08,vf14		nop
	maddw.xyz vf05,vf05,vf14	nop
.endif

	nop				nop
	nop				nop
	nop				sq vf01,IN_VERTEX(0,vi02)
	nop				sq vf05,IN_NORMAL(0,vi02)
	nop				iaddiu vi02,vi02,numInAttribs
	nop				nop

	nop				ibne vi02,vi03,SkinLoop
	nop				iaddiu vi04,vi04,numUnpackAttribs

.endif

	nop				ilw.w vi15,lightBase(vi00)	; light processor
	nop				jalr vi15,vi15
	nop				nop
	nop				nop
	nop				jr vi09
	nop				nop

#include "std_lighting.vu"

Process:
#include "default_proc.vu"
TLClip:
#include "TLclip.vu"
TSClip:
#include "TSclip.vu"

End:
	nop[e]				nop
	nop				nop
	nop				b restart
	nop				nop

#include "cliptri.vu"
#include "default_clipproc.vu"

.EndMPG
.EndDmaData


.global xtcCodeStdSkin
xtcCodeStdSkin:
.word code
.word vertexTop
.word vertCount
.word numUnpackAttribs
.word offset
.word inputDesc
; numVerts - indexed by prim type
.word vertCount & ~3		; point and non-ref strips
.word ((vertCount/2) & ~3)*2	; line list
.word (((vertCount&~3)-1) & ~3)+1	; line strip
.word ((vertCount/3) & ~3)*3	; tri list
.word (((vertCount&~3)-2) & ~3)+2	; tri strip
; code switch
.word Process, outBuf1, outBuf2, 0
.word TLClip, outBuf1, clipOutBuf2, 0
.word TSClip, outBuf1, clipOutBuf2, 0

inputDesc:
.word 5, 5
.word XTCP_POSITION, 0, UNPACK_V4_32
.word XTCP_TEXCOORD, 1, UNPACK_V2_32
.word XTCP_COLOR,    2, UNPACK_V4_8 | UNPACK_USN
.word XTCP_NORMAL,   3, UNPACK_V3_8
.word XTCP_SKINDATA, 4, UNPACK_V4_32

.global xtcStdSkinLightProcs
xtcStdSkinLightProcs:
	.word LtWhiteV
	.word LtBaseV
	.word LtBaseVDir
	.word LtBaseVDirV
	.word LtBaseVDir8
